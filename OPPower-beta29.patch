+            if (insight.health != null) {
+                CouiDivider()
+                CouiRow(
+                    title = "电池健康",
+                    summary = insight.health!!.let { "${it.fullMah} / ${it.designMah} mAh" },
+                    value = insight.health!!.percent?.let { "$it%" } ?: "—",
+                )
+                insight.health!!.cycleCount?.let { cycles ->

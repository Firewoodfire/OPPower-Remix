+
+/**
+ * ColorOS 17 / COUI-Kit 的排版与布局度量。
+ *
+ * 数值来自 COUI-Kit 0.0.1-alpha16 的 `CouiPageDefaults`、`CouiTextKind` 与
+ * `CouiSwitchDefaults`：卡片 24dp 连续圆角、页面左右 16dp、行内 16dp、行高 48dp、
+ * 分隔线 0.33dp、组标题与脚注内缩 32dp、开关 44×24 配 18dp 滑块。
+ *
+ * 该库当前要求 compileSdk 37 + AGP 9.1 才能消费其 AAR，与本项目的构建基线冲突，
+ * 因此这里按同一套公开度量实现等价组件，而不是引入二进制依赖。
+ */
+internal object Coui {
+    val pageMargin = 16.dp
+    val rowPadding = 16.dp
+    val rowMinHeight = 48.dp
+    val rowMinHeightCompact = 42.dp
+    val contentPadding = 10.dp
+    val contentPaddingCompact = 7.dp
+    val iconSpacing = 16.dp
+    val iconBox = 28.dp
+    val groupSpacing = 16.dp
+    val categoryTopSpacing = 12.dp
+    val cardRadius = 24.dp
+    val titleInset = 32.dp
+    val dividerHeight = 0.33.dp
+    val switchWidth = 44.dp
+    val switchHeight = 24.dp
+    val thumbSize = 18.dp
+    val thumbPadding = 3.dp
+    val segmentHeight = 38.dp
+
+    val itemTitle = TextStyle(fontSize = 16.sp, fontWeight = FontWeight.Medium)
+    val itemSummary = TextStyle(fontSize = 13.sp, fontWeight = FontWeight.Normal, lineHeight = 18.sp)
+    val itemValue = TextStyle(fontSize = 14.sp, fontWeight = FontWeight.Normal)
+    val groupTitle = TextStyle(fontSize = 12.sp, fontWeight = FontWeight.Medium)
+    val groupFooter = TextStyle(fontSize = 12.sp, fontWeight = FontWeight.Normal, lineHeight = 17.sp)
+    val pageTitle = TextStyle(fontSize = 26.sp, fontWeight = FontWeight.SemiBold)
+    val metricValue = TextStyle(fontSize = 22.sp, fontWeight = FontWeight.SemiBold)
+
+    /** 紧凑模式下的字号收敛：标题与摘要各降 1sp，正文与数值不动以保持可读。 */
+    val itemTitleCompact = TextStyle(fontSize = 15.sp, fontWeight = FontWeight.Medium)
+    val itemSummaryCompact = TextStyle(fontSize = 12.sp, fontWeight = FontWeight.Normal, lineHeight = 16.sp)
+}
+
+/**
+ * 当前生效的行密度。由 [ProvideCouiMetrics] 在根布局注入，默认舒适。
+ *
+ * 拆分原因：`UiDensity` 属于 model 层，这里不直接依赖它，避免 UI 基础组件
+ * 反向耦合业务枚举；调用方只需把枚举映射成一个布尔值。
+ */
+internal data class CouiMetrics(
+    val compact: Boolean = false,
+) {
+    val rowMinHeight: Dp get() = if (compact) Coui.rowMinHeightCompact else Coui.rowMinHeight
+    val contentPadding: Dp get() = if (compact) Coui.contentPaddingCompact else Coui.contentPadding
+    val itemTitle: TextStyle get() = if (compact) Coui.itemTitleCompact else Coui.itemTitle
+    val itemSummary: TextStyle get() = if (compact) Coui.itemSummaryCompact else Coui.itemSummary
+}
+
+internal val LocalCouiMetrics = staticCompositionLocalOf { CouiMetrics() }
+
+@Composable
+internal fun ProvideCouiMetrics(compact: Boolean, content: @Composable () -> Unit) {
+    CompositionLocalProvider(LocalCouiMetrics provides CouiMetrics(compact = compact), content = content)
+}
+
+/** 分组卡片：单一 24dp 容器，条目之间用 0.33dp 分隔线，不再嵌套多层玻璃。 */
+@Composable
+internal fun CouiCard(
+    modifier: Modifier = Modifier,
+    content: @Composable ColumnScope.() -> Unit,
+) {
+    val shape = RoundedCornerShape(Coui.cardRadius)
+    Column(
+        modifier
+            .fillMaxWidth()
+            .clip(shape)
+            .background(Surface)
+            .border(0.5.dp, Outline.copy(alpha = 0.34f), shape),
+        content = content,
+    )
+}
+
+@Composable
+internal fun CouiGroup(
+    title: String? = null,
+    footer: String? = null,
+    modifier: Modifier = Modifier,
+    content: @Composable ColumnScope.() -> Unit,
+) {
+    Column(
+        modifier
+            .fillMaxWidth()
+            .padding(top = if (title.isNullOrEmpty()) Coui.groupSpacing else Coui.categoryTopSpacing),
+    ) {
+        if (!title.isNullOrEmpty()) {
+            Text(
+                title,
+                style = Coui.groupTitle,
+                color = TextSecondary,
+                modifier = Modifier.padding(start = Coui.titleInset, end = Coui.titleInset, top = 8.dp, bottom = 8.dp),
+            )
+        }
+        CouiCard(content = content)
+        if (!footer.isNullOrEmpty()) {
+            Text(
+                footer,
+                style = Coui.groupFooter,
+                color = TextSecondary.copy(alpha = 0.86f),
+                modifier = Modifier.padding(start = Coui.titleInset, end = Coui.titleInset, top = 8.dp),
+            )
+        }
+    }
+}

+
+/**
+ * 充电检测卡片。
+ *
+ * 信息分层参考 Scene 的充电统计：先回答“现在充得多快”，再回答“为什么不是更快”，
+ * 最后补电池健康。默认只显示四个最有决策价值的指标，其余折叠，避免主页面变成仪表盘。
+ */
+@Composable
+internal fun ChargeDetectCard(
+    insight: ChargeInsight,
+    settings: RuntimeSettings,
+    onOpenSettings: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    var expanded by remember { mutableStateOf(false) }
+    val stageColor = when (insight.stage) {
+        ChargeStage.CONSTANT_CURRENT -> Cyan
+        ChargeStage.CONSTANT_VOLTAGE, ChargeStage.TRICKLE -> Amber
+        ChargeStage.FULL -> Cyan
+        ChargeStage.HANDSHAKE -> Amber
+        ChargeStage.DISCONNECTED, ChargeStage.DISCHARGING -> TextSecondary
+    }
+    CouiGroup(title = "充电检测") {
+        Column(Modifier.fillMaxWidth().padding(horizontal = Coui.rowPadding, vertical = 14.dp)) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Column(Modifier.weight(1f)) {
+                    Text(
+                        when {
+                            !insight.hasData -> "—"
+                            insight.stage == ChargeStage.DISCONNECTED -> "未接电"
+                            else -> "${insight.inputPowerW.oneDecimal()}"
+                        },
+                        style = TextStyleHuge,
+                        color = TextPrimary,
+                    )
+                    Text(
+                        when {
+                            insight.stage == ChargeStage.DISCONNECTED -> "接电后自动识别充电器"
+                            else -> "电池侧输入功率"
+                        },
+                        style = Coui.groupFooter,
+                        color = TextSecondary,
+                    )
+                }
+                StageChip(label = insight.stage.label, color = stageColor)
+            }
+
+            Spacer(Modifier.height(12.dp))
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                CouiMetric(
+                    label = "充电器",
+                    value = insight.capability?.let { "${it.maxPowerW.toInt()} W" } ?: "—",
+                    detail = insight.capability?.protocolLabel ?: "未识别",
+                    modifier = Modifier.weight(1f),
+                )
+                CouiMetric(
+                    label = "预计充满",
+                    value = insight.minutesToFull?.let(::formatMinutes) ?: "—",
+                    detail = if (insight.minutesToFull == null) "等待样本" else "按当前斜率",
+                    modifier = Modifier.weight(1f),
+                )
+                CouiMetric(
+                    label = "稳定性",
+                    value = "${insight.stabilityPercent}%",
+                    detail = stabilityLabel(insight.stabilityPercent),
+                    modifier = Modifier.weight(1f),
+                )
+            }
+
+            if (insight.anomalies.isNotEmpty()) {
+                Spacer(Modifier.height(12.dp))
+                Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                    insight.anomalies.take(if (expanded) 4 else 2).forEach { text ->
+                        Row(verticalAlignment = Alignment.Top) {
+                            Box(
+                                Modifier
+                                    .padding(top = 6.dp)
+                                    .size(5.dp)
+                                    .clip(CircleShape)
+                                    .background(Amber),
+                            )
+                            Text(
+                                text,
+                                style = Coui.itemSummary,
+                                color = Amber,
+                                modifier = Modifier.padding(start = 8.dp),
+                            )
+                        }
+                    }
+                }
+            }
+
+            AnimatedVisibility(
+                visible = expanded,
+                enter = expandVertically(spring(stiffness = 380f)) + fadeIn(),
+                exit = shrinkVertically(spring(stiffness = 380f)) + fadeOut(),
+            ) {
+                Column {
+                    Spacer(Modifier.height(10.dp))
+                    CouiDivider(startIndent = 0.dp, endIndent = 0.dp)
+                    DetailRow("当前阶段", insight.stageDetail)
+                    insight.utilizationPercent?.let {
+                        DetailRow("充电器利用率", "$it%")
+                    }
+                    insight.chargeMahThisSession?.let {
+                        DetailRow("本次充入", "$it mAh")
+                    }
+                    insight.efficiencyPercent?.let {
+                        DetailRow("估算效率", "$it% · 含线损与升压损耗")
+                    }
+                    if (settings.showBatteryHealth) {
+                        insight.health?.let { health ->
+                            DetailRow(
+                                "电池健康",
+                                health.percent?.let { "$it% · ${health.fullMah} / ${health.designMah} mAh" }
+                                    ?: "读数不足",
+                            )
+                            health.cycleCount?.let { DetailRow("循环次数", "$it 次") }
+                        }
+                    }
+                    insight.capability?.let { cap ->
+                        DetailRow(
+                            "充电器能力",
+                            "${cap.maxVoltageMv / 1000f} V / ${cap.maxCurrentMa / 1000f} A · ${cap.supplyName}",
+                        )
+                    }
+                }
+            }
+
+            Row(
+                Modifier
+                    .fillMaxWidth()
+                    .padding(top = 12.dp)
+                    .clip(RoundedCornerShape(12.dp))
+                    .clickable { expanded = !expanded }
+                    .padding(vertical = 4.dp),
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                Text(
+                    if (expanded) "收起详情" else "查看详情",
+                    style = Coui.itemSummary,
+                    color = Cyan,
+                    modifier = Modifier.weight(1f),
+                )
+                Text(
+                    if (expanded) "⌃" else "⌄",
+                    color = Cyan,
+                    fontSize = 14.sp,
+                )
+                Spacer(Modifier.width(14.dp))
+                Text(
+                    "检测设置",
+                    style = Coui.itemSummary,
+                    color = TextSecondary,
+                    modifier = Modifier.clickable(onClick = onOpenSettings),
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun StageChip(label: String, color: Color) {
+    Row(
+        Modifier
+            .clip(CircleShape)
+            .background(color.copy(alpha = 0.14f))
+            .padding(horizontal = 12.dp, vertical = 6.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        val pulse by animateFloatAsState(
+            targetValue = 1f,
+            animationSpec = spring(stiffness = 200f),
+            label = "stage-pulse",
+        )
+        Canvas(Modifier.size(6.dp)) { drawCircle(color = color.copy(alpha = 0.4f + 0.6f * pulse)) }
+        Text(
+            label,
+            color = color,
+            fontSize = 12.sp,
+            fontWeight = FontWeight.Medium,
+            modifier = Modifier.padding(start = 6.dp),
+        )
+    }
+}
+
+@Composable
+private fun CouiMetric(label: String, value: String, detail: String, modifier: Modifier = Modifier) {
+    Column(
+        modifier
+            .clip(RoundedCornerShape(16.dp))
+            .background(Outline.copy(alpha = 0.20f))
+            .padding(horizontal = 10.dp, vertical = 9.dp),
+    ) {
+        Text(label, fontSize = 11.sp, color = TextSecondary)
+        Text(
+            value,
+            fontSize = 17.sp,
+            fontWeight = FontWeight.SemiBold,
+            color = TextPrimary,
+            modifier = Modifier.padding(top = 2.dp),
+        )
+        Text(
+            detail,
+            fontSize = 10.sp,
+            color = TextSecondary.copy(alpha = 0.85f),
+            maxLines = 1,
+        )
+    }
+}
+
+@Composable
+private fun DetailRow(label: String, value: String) {
+    Row(
+        Modifier.fillMaxWidth().padding(vertical = 7.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Text(label, style = Coui.itemSummary, color = TextSecondary, modifier = Modifier.width(96.dp))
+        Text(value, style = Coui.itemSummary, color = TextPrimary, modifier = Modifier.weight(1f))
+    }
+}
+
+/** 稳定性条形指示，避免用第二个大圆环抢主视觉。 */
+@Composable
+internal fun StabilityBar(percent: Int, modifier: Modifier = Modifier) {
+    Canvas(modifier.fillMaxWidth().height(4.dp)) {
+        val radius = size.height / 2f
+        drawRoundRect(color = Outline.copy(alpha = 0.4f), cornerRadius = androidx.compose.ui.geometry.CornerRadius(radius))
+        drawLine(
+            color = if (percent >= 80) Cyan else Amber,
+            start = Offset(0f, size.height / 2f),
+            end = Offset(size.width * (percent / 100f), size.height / 2f),
+            strokeWidth = size.height,
+            cap = StrokeCap.Round,
+        )
+    }
+}
+
+internal fun stabilityLabel(percent: Int): String = when {
+    percent >= 85 -> "平稳"
+    percent >= 65 -> "轻微波动"
+    else -> "波动明显"
+}
+
+internal fun formatMinutes(minutes: Int): String = when {
+    minutes < 60 -> "$minutes 分钟"
+    else -> "${minutes / 60} 小时 ${minutes % 60} 分"
+}
+
+private val TextStyleHuge = androidx.compose.ui.text.TextStyle(
+    fontSize = 34.sp,
+    fontWeight = FontWeight.SemiBold,
+    letterSpacing = (-0.5).sp,
+)

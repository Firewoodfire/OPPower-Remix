+                        .coerceAtLeast(2),
+                    onSelected = { index ->
+                        onSettingsChange {
+                            it.copy(detectionIntervalSeconds = listOf(3, 5, 10, 20, 30)[index])
+                        }
+                    },
+                )
+            }
+        }
+        CouiGroup("提醒") {
+            CouiSwitchRow(
+                title = "异常提醒",
+                summary = "电流为零、功率波动或温度偏高时发一条通知",
+                checked = settings.anomalyAlertEnabled,
+                onCheckedChange = { value -> onSettingsChange { it.copy(anomalyAlertEnabled = value) } },
+            )
+            CouiDivider()
+            CouiSwitchRow(
+                title = "充满提醒",
+                summary = "电量达到 100% 时提醒拔电，便于保护电池",
+                checked = settings.fullChargeAlertEnabled,
+                onCheckedChange = { value -> onSettingsChange { it.copy(fullChargeAlertEnabled = value) } },
+            )
+        }
+        CouiGroup("显示") {
+            CouiSwitchRow(
+                title = "显示电池健康",
+                summary = "由满充容量与设计容量估算，仅供参考",
+                checked = settings.showBatteryHealth,
+                onCheckedChange = { value -> onSettingsChange { it.copy(showBatteryHealth = value) } },
+            )
+        }
+        CouiGroup("本次检测") {
+            CouiRow(
+                title = "充电阶段",
+                summary = insight.stageDetail.ifBlank { "接电后自动判断" },
+                value = insight.stage.label,
+                valueColor = Cyan,
+            )
+            CouiDivider()
+            CouiRow(
+                title = "充电器",
+                summary = insight.capability?.let { "${it.supplyName} · ${it.supplyType}" } ?: "未识别到供电节点",
+                value = insight.capability?.let { "${it.maxPowerW.toInt()} W" } ?: "—",
+            )
+            CouiDivider()
+            CouiRow(
+                title = "利用率",
+                summary = "实际输入功率 / 充电器声称能力",
+                value = insight.utilizationPercent?.let { "$it%" } ?: "—",
+            )
+            CouiDivider()
+            CouiRow(
+                title = "稳定性",
+                summary = stabilityLabel(insight.stabilityPercent),
+                value = "${insight.stabilityPercent}%",

+    /**
+     * 导出最近 24 小时原始采样为 CSV。写入调用方给定的文件，返回导出行数。
+     * 使用与页面相同的列顺序，便于直接用表格软件打开。
+     */
+    fun exportCsv(target: File, nowMillis: Long = System.currentTimeMillis()): Int = synchronized(LOCK) {
+        val cutoff = (nowMillis - RETENTION_MILLIS).coerceAtLeast(0L)
+        val points = readSince(cutoff)
+        target.parentFile?.mkdirs()
+        val clock = java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss", java.util.Locale.getDefault())
+        target.bufferedWriter().use { writer ->
+            writer.write("epoch_ms,time,power_w,temperature_c,soc,ac_online,current_ma,voltage_mv")
+            writer.write("\n")
+            points.forEach { point ->
+                val line = buildString {
+                    append(point.epochMillis)
+                    append(',')
+                    append(clock.format(java.util.Date(point.epochMillis)))
+                    append(',')
+                    append(point.powerW)
+                    append(',')
+                    append(point.temperatureC)
+                    append(',')
+                    append(point.levelPercent)
+                    append(',')
+                    append(if (point.acOnline) 1 else 0)
+                    append(',')
+                    append(point.currentMa)
+                    append(',')
+                    append(point.voltageMv)
+                    append('\n')
+                }
+                writer.write(line)
+            }
+        }
+        points.size
+    }

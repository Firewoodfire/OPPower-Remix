+@Composable
+internal fun CouiSwitchRow(
+    title: String,
+    summary: String? = null,
+    checked: Boolean,
+    enabled: Boolean = true,
+    onCheckedChange: (Boolean) -> Unit,
+) {
+    CouiRow(
+        title = title,
+        summary = summary,
+        enabled = enabled,
+        role = Role.Switch,
+        onClick = { if (enabled) onCheckedChange(!checked) },
+        trailing = {
+            CouiSwitch(checked = checked, enabled = enabled, onCheckedChange = onCheckedChange)
+        },
+    )
+}

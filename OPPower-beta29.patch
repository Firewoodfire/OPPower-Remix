+/** 44×24 开关，滑块 18dp，行程 20dp；点击与拖动都走同一个业务回调。 */
+@Composable
+internal fun CouiSwitch(
+    checked: Boolean,
+    onCheckedChange: (Boolean) -> Unit,
+    enabled: Boolean = true,
+) {
+    val haptic = LocalHapticFeedback.current
+    val progress by animateFloatAsState(
+        targetValue = if (checked) 1f else 0f,
+        animationSpec = spring(dampingRatio = 0.72f, stiffness = 720f),
+        label = "coui-switch",
+    )
+    val trackOff = Outline.copy(alpha = if (enabled) 0.75f else 0.4f)
+    val track by animateColorAsState(
+        targetValue = if (checked) Cyan.copy(alpha = if (enabled) 1f else 0.45f) else trackOff,
+        animationSpec = spring(stiffness = Spring.StiffnessLow),
+        label = "coui-switch-track",
+    )
+    Box(
+        Modifier
+            .size(Coui.switchWidth, Coui.switchHeight)
+            .clip(CircleShape)
+            .background(track)
+            .clickable(
+                enabled = enabled,
+                role = Role.Switch,
+                indication = null,
+                interactionSource = remember { MutableInteractionSource() },
+            ) {
+                haptic.performHapticFeedback(HapticFeedbackType.TextHandleMove)
+                onCheckedChange(!checked)
+            },
+    ) {
+        val travel = Coui.switchWidth - Coui.thumbSize - Coui.thumbPadding * 2
+        Canvas(Modifier.fillMaxSize()) {
+            val thumb = Coui.thumbSize.toPx()
+            val pad = Coui.thumbPadding.toPx()
+            val x = pad + travel.toPx() * progress
+            drawCircle(
+                color = Color.White.copy(alpha = if (enabled) 1f else 0.7f),
+                radius = thumb / 2f,
+                center = Offset(x + thumb / 2f, size.height / 2f),
+            )
+        }
+    }
+}
+
+/** 胶囊分段选择器；指示器跟手动画，点击即提交。 */
+@Composable
+internal fun CouiSegmented(
+    labels: List<String>,
+    selectedIndex: Int,
+    modifier: Modifier = Modifier,
+    onSelected: (Int) -> Unit,
+) {
+    if (labels.isEmpty()) return
+    val safeIndex = selectedIndex.coerceIn(0, labels.lastIndex)
+    val fraction by animateFloatAsState(
+        targetValue = safeIndex / labels.lastIndex.coerceAtLeast(1).toFloat(),
+        animationSpec = spring(dampingRatio = 0.78f, stiffness = 520f),
+        label = "coui-segment",
+    )
+    Row(
+        modifier
+            .fillMaxWidth()
+            .height(Coui.segmentHeight)
+            .clip(CircleShape)
+            .background(Outline.copy(alpha = 0.30f))
+            .padding(3.dp),
+    ) {
+        Box(Modifier.fillMaxSize()) {
+            Canvas(Modifier.fillMaxSize()) {
+                val segment = size.width / labels.size
+                val x = (size.width - segment) * fraction
+                drawRoundRect(
+                    color = Surface,
+                    topLeft = Offset(x, 0f),
+                    size = Size(segment, size.height),
+                    cornerRadius = androidx.compose.ui.geometry.CornerRadius(size.height / 2f),
+                )
+            }
+            Row(Modifier.fillMaxSize()) {
+                labels.forEachIndexed { index, label ->
+                    Box(
+                        Modifier
+                            .weight(1f)
+                            .fillMaxSize()
+                            .clip(CircleShape)
+                            .clickable(
+                                indication = null,
+                                interactionSource = remember { MutableInteractionSource() },
+                            ) { onSelected(index) },
+                        contentAlignment = Alignment.Center,
+                    ) {
+                        Text(
+                            label,
+                            fontSize = 13.sp,
+                            fontWeight = if (index == safeIndex) FontWeight.SemiBold else FontWeight.Normal,
+                            color = if (index == safeIndex) Cyan else TextSecondary,
+                            maxLines = 1,
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+internal fun CouiChoiceRow(
+    title: String,
+    labels: List<String>,
+    selectedIndex: Int,
+    summary: String? = null,
+    onSelected: (Int) -> Unit,
+) {
+    Column(
+        Modifier
+            .fillMaxWidth()
+            .padding(horizontal = Coui.rowPadding, vertical = LocalCouiMetrics.current.contentPadding),
+    ) {
+        Text(title, style = LocalCouiMetrics.current.itemTitle, color = TextPrimary)
+        if (!summary.isNullOrEmpty()) {
+            Text(summary, style = LocalCouiMetrics.current.itemSummary, color = TextSecondary, modifier = Modifier.padding(top = 2.dp))
+        }
+        CouiSegmented(
+            labels = labels,
+            selectedIndex = selectedIndex,
+            modifier = Modifier.padding(top = 10.dp),
+            onSelected = onSelected,
+        )
+    }
+}
+
+/** 二级页面外壳：返回圆钮 + 大标题 + 统一安全区与滚动。 */
+@Composable
+internal fun CouiPage(
+    title: String,
+    subtitle: String? = null,
+    onBack: () -> Unit,
+    content: @Composable ColumnScope.() -> Unit,
+) {
+    Column(
+        Modifier
+            .fillMaxSize()
+            .verticalScroll(rememberScrollState())
+            .padding(horizontal = Coui.pageMargin, vertical = 10.dp),
+        verticalArrangement = Arrangement.spacedBy(2.dp),
+    ) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Box(
+                Modifier
+                    .size(40.dp)
+                    .clip(CircleShape)
+                    .background(Surface)
+                    .border(0.5.dp, Outline.copy(alpha = 0.34f), CircleShape)
+                    .clickable(onClick = onBack),
+                contentAlignment = Alignment.Center,
+            ) {
+                Text("‹", color = TextPrimary, fontSize = 24.sp, modifier = Modifier.padding(bottom = 2.dp))
+            }
+            Column(Modifier.padding(start = 14.dp)) {
+                Text(title, style = Coui.pageTitle, color = TextPrimary)
+                if (!subtitle.isNullOrEmpty()) {
+                    Text(
+                        subtitle,
+                        style = Coui.groupFooter,
+                        color = TextSecondary,
+                        modifier = Modifier.padding(top = 2.dp),
+                    )
+                }
+            }
+        }
+        content()
+        Spacer(Modifier.height(20.dp))
+    }
+}
+
+/** 设置搜索框：单行胶囊，空态显示提示，输入即过滤。 */
+@Composable
+internal fun CouiSearchField(
+    value: String,
+    onValueChange: (String) -> Unit,
+    placeholder: String = "搜索设置",
+) {
+    Row(
+        Modifier
+            .fillMaxWidth()
+            .height(40.dp)
+            .clip(CircleShape)
+            .background(Surface)
+            .border(0.5.dp, Outline.copy(alpha = 0.34f), CircleShape)
+            .padding(horizontal = 14.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Canvas(Modifier.size(15.dp)) {
+            val stroke = Stroke(width = 1.6.dp.toPx())
+            drawCircle(
+                color = TextSecondary,
+                radius = size.minDimension * 0.34f,
+                center = Offset(size.width * 0.42f, size.height * 0.42f),
+                style = stroke,
+            )
+            drawLine(
+                color = TextSecondary,
+                start = Offset(size.width * 0.68f, size.height * 0.68f),
+                end = Offset(size.width * 0.94f, size.height * 0.94f),
+                strokeWidth = 1.6.dp.toPx(),
+            )
+        }
+        Box(Modifier.weight(1f).padding(start = 10.dp)) {
+            if (value.isEmpty()) {
+                Text(placeholder, style = Coui.itemSummary, color = TextSecondary.copy(alpha = 0.8f))
+            }
+            BasicTextField(
+                value = value,
+                onValueChange = onValueChange,
+                singleLine = true,
+                textStyle = Coui.itemSummary.copy(color = TextPrimary),
+                cursorBrush = SolidColor(Cyan),
+                keyboardOptions = androidx.compose.foundation.text.KeyboardOptions(imeAction = ImeAction.Search),
+                modifier = Modifier.fillMaxWidth(),
+            )
+        }
+        if (value.isNotEmpty()) {
+            Text(
+                "✕",
+                color = TextSecondary,
+                fontSize = 13.sp,
+                modifier = Modifier
+                    .clip(CircleShape)
+                    .clickable { onValueChange("") }
+                    .padding(4.dp),
+            )
+        }
+    }
+}

+/**
+ * 通用行。`onClick` 为空时不安装点击语义，与 COUI 的 `Item` 一致；
+ * 末端的值、开关或箭头由 [trailing] 提供。
+ */
+@Composable
+internal fun CouiRow(
+    title: String,
+    summary: String? = null,
+    icon: (@Composable () -> Unit)? = null,
+    leading: (@Composable () -> Unit)? = null,
+    value: String? = null,
+    valueColor: Color = TextSecondary,
+    chevron: Boolean = false,
+    enabled: Boolean = true,
+    role: Role? = null,
+    minHeight: Dp = LocalCouiMetrics.current.rowMinHeight,
+    onClick: (() -> Unit)? = null,
+    trailing: (@Composable RowScope.() -> Unit)? = null,
+) {
+    val interaction = remember { MutableInteractionSource() }
+    val metrics = LocalCouiMetrics.current
+    Row(
+        Modifier
+            .fillMaxWidth()
+            .then(
+                if (onClick != null) {
+                    Modifier.clickable(
+                        interactionSource = interaction,
+                        indication = null,
+                        enabled = enabled,
+                        role = role,
+                        onClick = onClick,
+                    )
+                } else {
+                    Modifier
+                },
+            )
+            .heightIn(min = minHeight)
+            .padding(horizontal = Coui.rowPadding, vertical = metrics.contentPadding),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        if (icon != null) {
+            Box(Modifier.size(Coui.iconBox), contentAlignment = Alignment.Center) { icon() }
+            Spacer(Modifier.width(Coui.iconSpacing))
+        }
+        leading?.invoke()
+        Column(Modifier.weight(1f)) {
+            Text(
+                title,
+                style = metrics.itemTitle,
+                color = if (enabled) TextPrimary else TextSecondary.copy(alpha = 0.5f),
+                maxLines = 2,
+                overflow = TextOverflow.Ellipsis,
+            )
+            if (!summary.isNullOrEmpty()) {
+                Text(
+                    summary,
+                    style = metrics.itemSummary,
+                    color = TextSecondary,
+                    modifier = Modifier.padding(top = 2.dp),
+                )
+            }
+        }
+        if (value != null) {
+            Text(
+                value,
+                style = Coui.itemValue,
+                color = if (enabled) valueColor else TextSecondary.copy(alpha = 0.5f),
+                modifier = Modifier.padding(start = 12.dp),
+                maxLines = 1,
+            )
+        }
+        trailing?.let {
+            Row(verticalAlignment = Alignment.CenterVertically, content = it)
+        }
+        if (chevron) {
+            Text(
+                "›",
+                color = TextSecondary.copy(alpha = 0.8f),
+                fontSize = 18.sp,
+                modifier = Modifier.padding(start = 6.dp),
+            )
+        }
+    }
+}

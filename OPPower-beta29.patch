+@Composable
+internal fun CouiDivider(
+    startIndent: Dp = Coui.rowPadding,
+    endIndent: Dp = Coui.rowPadding,
+) {
+    Box(
+        Modifier
+            .fillMaxWidth()
+            .padding(start = startIndent, end = endIndent)
+            .height(Coui.dividerHeight)
+            .background(Outline.copy(alpha = 0.55f)),

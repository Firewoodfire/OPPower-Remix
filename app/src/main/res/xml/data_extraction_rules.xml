<?xml version="1.0" encoding="utf-8"?>
<!--
  OPPower 的本地数据只有偏好设置与 24 小时充电曲线，且应用本身没有网络权限。
  备份到云端没有收益，反而会把设备功率画像带出本机，因此云备份与设备迁移
  一律排除；用户主动导出 CSV 仍走系统分享面板。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
